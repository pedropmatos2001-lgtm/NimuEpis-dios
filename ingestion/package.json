{
  "name": "nimu-ingestion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nimu — season ingestion (AnimeSchedule.net + TVDB/TMDB + manami-DB → Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node src/run.js",
    "start": "node src/run.js",
    "dry-run": "node src/run.js --dry-run",
    "catalogue": "node src/catalogue.js",
    "catalogue:episodes": "node src/catalogue-episodes.js",
    "episodes:backfill": "node src/episodes-backfill.js",
    "catalogue:franchises": "node src/catalogue-franchises.js",
    "catalogue:franchises:dry": "node src/catalogue-franchises.js --dry-run",
    "catalogue:franchises:plan": "node src/catalogue-franchises.js --plan-only",
    "covers": "node src/covers.js",
    "covers:dry": "node src/covers.js --dry-run",
    "descriptions": "node src/descriptions.js",
    "descriptions:dry": "node src/descriptions.js --dry-run",
    "descriptions:plan": "node src/descriptions.js --plan",
    "push:send": "node src/push-sender.js",
    "push:send:dry": "node src/push-sender.js --dry-run",
    "audit": "node src/audit-data.js",
    "audit:fast": "node src/audit-data.js --no-http",
    "audit:json": "node src/audit-data.js --json",
    "test": "node --test",
    "banners": "node src/banners.js",
    "verify-tvdb": "node src/verify-tvdb.js",
    "verify-tvdb:apply": "node src/verify-tvdb.js --apply",
    "trailers": "node src/trailers.js",
    "trailers:dry": "node src/trailers.js --dry-run",
    "alt-titles": "node src/alt-titles.js",
    "alt-titles:dry": "node src/alt-titles.js --dry-run",
    "indexnow": "node src/indexnow.js",
    "indexnow:dry": "node src/indexnow.js --dry-run",
    "popularity": "node src/popularity.js",
    "popularity:dry": "node src/popularity.js --dry-run",
    "purge-adult": "node src/purge-adult.js",
    "purge-adult:apply": "node src/purge-adult.js --apply",
    "extras": "node src/reclassify-extras.js",
    "extras:plan": "node src/reclassify-extras.js --plan",
    "extras:dry": "node src/reclassify-extras.js --dry-run",
    "status": "node src/status-reconcile.js",
    "status:dry": "node src/status-reconcile.js --dry-run",
    "series:plan": "node src/series.js --plan",
    "series:dry": "node src/series.js --dry-run",
    "series:aplicar": "node src/series.js --aplicar"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "web-push": "^3.6.7"
  }
}
